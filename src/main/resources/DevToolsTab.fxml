<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<Tab xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="tabos.ui.DevToolsTabController" text="DevTools">
    <AnchorPane>
        <TabPane tabClosingPolicy="UNAVAILABLE" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.bottomAnchor="0.0">
            <Tab text="User Settings">
                <TextArea fx:id="settings" editable="false" />
            </Tab>
            <Tab text="Elements">
                <TreeView fx:id="elementsTree"/>
            </Tab>
        </TabPane>
        <HBox AnchorPane.topAnchor="1.0" AnchorPane.rightAnchor="5.0">
            <Button text="Select" onMouseClicked="#toggleElementSelector"/>
        </HBox>
    </AnchorPane>
</Tab>

