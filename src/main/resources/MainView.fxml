<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tabos.ui.MainViewController">
    <!-- Menu Bar -->
    <top>
        <VBox>
            <fx:include source="Menu.fxml" />
            <ToolBar fx:id="toolbar">
                <Button onAction="#handlePlay" text="Play" />
                <Button onAction="#handleStop" text="Stop" />
                <Button onAction="#handleRecord" text="Record" />
            </ToolBar>
        </VBox>
    </top>

    <!-- Main Content Area with Split Panes -->
    <center>
        <SplitPane fx:id="verticalSplitPane" orientation="VERTICAL">
            <SplitPane fx:id="horizontalSplitPane">
                <!-- Left Sidebar -->
                <VBox minWidth="50" prefWidth="250">
                    <TabPane fx:id="sidebarTabs" side="LEFT" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                        <Tab text="Project">
                            <TreeView fx:id="projectTree" />
                        </Tab>
                        <Tab text="Properties">
                            <VBox fx:id="propertiesBox" spacing="10" style="-fx-padding: 10;" />
                        </Tab>
                        <Tab text="Instruments">
                            <ListView fx:id="instrumentList" />
                        </Tab>
                    </TabPane>
                </VBox>

                <!-- Main Editor -->
                <StackPane>
                    <ScrollPane fitToWidth="true">
                        <VBox fx:id="scoreArea" spacing="20" style="-fx-padding: 20; -fx-background-color: white;" />
                    </ScrollPane>
                </StackPane>

                <!-- Right Sidebar -->
                <VBox minWidth="50" prefWidth="250">
                    <TabPane side="RIGHT" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                        <fx:include source="DevToolsTab.fxml" />
                    </TabPane>
                </VBox>

            </SplitPane>

            <!-- Bottom Pane -->
            <VBox minHeight="100" prefHeight="200">
                <TabPane fx:id="bottomTabs" side="LEFT" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <Tab text="Console" />
                    <Tab text="Timeline">
                        <ScrollPane>
                            <HBox fx:id="timeline" spacing="5" style="-fx-padding: 10;" />
                        </ScrollPane>
                    </Tab>
                    <Tab text="Mixer">
                        <HBox fx:id="mixer" spacing="10" style="-fx-padding: 10;" />
                    </Tab>
                </TabPane>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
